---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import DrivewayEstimator from '../components/DrivewayEstimator.astro';
import { cities, servicesForCity, type ResService, type City } from '../data/residential';

interface Props {
  service: ResService;
  city: City;
}

const { service, city } = Astro.props;
const slug = `${service.slug}-${city.slug}`;
const isGlass = service.slug === 'glass-railings';
const areaLabel = city.name;
const estimatorFor: Record<string, 'concrete' | 'stamped' | 'pavers'> = { 'concrete-driveway': 'concrete', 'stamped-concrete': 'stamped', 'paver-driveway': 'pavers' };
const estimator = estimatorFor[service.slug];
const sms = `sms:+19417308491?&body=${encodeURIComponent(`Hi, here's a photo of my project in ${city.name} (${service.name}). I'd like an estimate.`)}`;

const title = `${service.name} ${city.name} FL | Manatee Concrete`;
const description = `${service.name} in ${areaLabel}, FL. Get matched with a licensed, insured local contractor. ${service.short} Free estimates: 941-730-8491.`;
const canonical = `https://manateeconcrete.com/${slug}`;

const faqs = [
  ...service.faqs,
  {
    q: `Do I need a permit or HOA approval in ${city.name}?`,
    a: `It depends on the project. Driveways, structural work and anything in the right-of-way usually need a permit from ${city.permitOffice}. Many HOAs also require architectural approval for new hardscape, colors or railings. Your contractor will confirm what applies at your address and handle the permit paperwork.`,
  },
  {
    q: `What areas around ${city.name} do you serve?`,
    a: `Our partner contractors work throughout ${city.name}, including ${city.neighborhoods}, plus the rest of Manatee and Sarasota County.`,
  },
];

const related = servicesForCity(city.slug).filter(s => s.slug !== service.slug);
const otherCities = cities.filter(c => c.slug !== city.slug && (!service.cities || service.cities.includes(c.slug)));

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
};
const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": `${service.name} in ${city.name}, FL`,
  "serviceType": service.name,
  "provider": {
    "@type": "LocalBusiness",
    "name": "Manatee Concrete",
    "description": "Referral service connecting homeowners with licensed local concrete and paver contractors.",
    "url": "https://manateeconcrete.com",
    "telephone": "+19417308491",
    "address": { "@type": "PostalAddress", "addressLocality": "Bradenton", "addressRegion": "FL", "addressCountry": "US" }
  },
  "areaServed": { "@type": "City", "name": city.name, "containedInPlace": { "@type": "State", "name": "Florida" } },
  "description": description
};
---

<Base title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />
  <Nav />

  <section class={`lp-hero${service.heroImage ? '' : ' lp-hero-plain'}`}>
    {service.heroImage && <div class="lp-hero-bg"><img src={service.heroImage} alt={`${service.name} in ${city.name}, FL`} loading="eager" /></div>}
    <div class="lp-hero-overlay"></div>
    <div class="lp-hero-content container">
      <p class="hero-eyebrow">Residential — {areaLabel}, FL</p>
      <h1>{service.name} in {city.name}, FL</h1>
      <p class="hero-sub">{service.short}</p>
      <div class="lp-hero-ctas">
        <a href={estimator ? '#driveway-cost' : '#contact'} class="btn btn-white">{estimator ? 'Estimate My Cost' : 'Get a Free Estimate'}</a>
        <a href={sms} class="lp-hero-sms">or text us a photo: 941-730-8491</a>
      </div>
    </div>
  </section>

  <section class="lp-intro">
    <div class="container">
      <div class="lp-intro-inner">
        <div class="lp-intro-text">
          <span class="section-label">{service.name} in {city.name}</span>
          <h2>{service.name} for {city.name} Homes</h2>
          <p class="lp-lead">{service.intro(city)}</p>
          {service.body.map(p => <p>{p}</p>)}
          <div class="lp-cost">
            <h3>What does it cost?</h3>
            <p>{service.cost} Every project is different, so your contractor provides a written estimate after seeing the site.</p>
            {estimator && <p style="margin-top:.6rem!important"><a href="#driveway-cost" style="color:var(--gold);font-weight:700;text-decoration:underline">Get a ballpark price for your driveway size &rarr;</a></p>}
          </div>
          <a href="#contact" class="btn btn-gold" style="margin-top:1.5rem">Get My Estimate</a>
        </div>
        <div class="lp-bullets-box">
          <h3>What's Included</h3>
          <ul>{service.bullets.map(b => <li>{b}</li>)}</ul>
          <div class="lp-cta-box">
            <p>Free estimates in {city.name}</p>
            <a href="tel:9417308491">941-730-8491</a>
            <a href="#contact" class="btn btn-gold" style="margin-top:.75rem;width:100%;text-align:center">Request an Estimate</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {estimator && <DrivewayEstimator city={city.name} initial={estimator} page={canonical} />}

  <section class="lp-local">
    <div class="container">
      <div class="lp-local-inner">
        <span class="section-label">Local to {city.name}</span>
        <h2>Working in {city.name} and {city.county}</h2>
        <p>{city.localNote}</p>
        <p>Our partner contractors serve {city.neighborhoods}, and pull permits through {city.permitOffice} when your project needs one.</p>
      </div>
    </div>
  </section>

  <section class="lp-why">
    <div class="container">
      <span class="section-label">Why Manatee Concrete</span>
      <h2>The Right Contractor for Your {city.name} Project</h2>
      <div class="lp-why-grid">
        <div class="lp-why-card"><h3>Licensed &amp; Insured</h3><p>We only refer contractors who carry the licenses and insurance their work requires.</p></div>
        <div class="lp-why-card"><h3>Built From the Base Up</h3><p>Most failures start underneath. Our partners don't cut corners on demo, base prep and compaction.</p></div>
        <div class="lp-why-card"><h3>Written Estimates</h3><p>A clear, itemized price after the contractor sees the site. No vague allowances.</p></div>
        <div class="lp-why-card"><h3>Free to You</h3><p>Our service costs you nothing. You deal directly with the contractor, and you're never obligated to hire.</p></div>
      </div>
    </div>
  </section>

  <section class="lp-process">
    <div class="container">
      <span class="section-label">How It Works</span>
      <h2>Simple. Transparent. Delivered.</h2>
      <div class="lp-process-steps">
        <div class="lp-step"><span>1</span><p>Free Estimate</p></div>
        <div class="lp-step"><span>2</span><p>Design &amp; Samples</p></div>
        <div class="lp-step"><span>3</span><p>HOA &amp; Permits</p></div>
        <div class="lp-step"><span>4</span><p>Build &amp; Walkthrough</p></div>
      </div>
    </div>
  </section>

  {service.gallery && (
    <section class="lp-gallery">
      <div class="container">
        <span class="section-label">Recent Work</span>
        <h2>Recent Paver Projects by Our Partner Contractor</h2>
        <div class="lp-gallery-grid">
          {service.gallery.map(g => <figure><img src={g.src} alt={g.alt} loading="lazy" width="900" height="1200" /><figcaption>{g.alt}</figcaption></figure>)}
        </div>
      </div>
    </section>
  )}

  <section class="lp-related">
    <div class="container">
      <span class="section-label">More in {city.name}</span>
      <h2>Other Residential Services</h2>
      <div class="lp-related-grid">
        {related.map(s => (
          <a href={`/${s.slug}-${city.slug}`} class="lp-related-card"><span>{s.name} in {city.name}</span><i>&rarr;</i></a>
        ))}
      </div>
      {otherCities.length > 0 && (
        <div class="lp-other-cities">
          <h3>{service.name} in Nearby Areas</h3>
          <div class="lp-related-grid">
            {otherCities.map(c => (
              <a href={`/${service.slug}-${c.slug}`} class="lp-related-card"><span>{service.name} in {c.name}</span><i>&rarr;</i></a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="lp-faq">
    <div class="container">
      <span class="section-label">Common Questions</span>
      <h2>{service.name} FAQs</h2>
      <div class="lp-faq-list">
        {faqs.map(f => (
          <details class="lp-faq-item"><summary>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </div>
    </div>
  </section>

  <section class="contact" id="contact">
    <div class="container">
      <div class="contact-inner">
        <div class="contact-info">
          <span class="section-label">Let's Talk</span>
          <h2>{service.name} in {city.name}: Get a Free Estimate</h2>
          <p>Tell us about your project and we'll match you with a licensed local contractor, who will reach out within one business day to set up a free estimate.</p>
          <div class="contact-detail"><strong>Phone:</strong> <span>941-730-8491</span></div>
          <div class="contact-detail"><strong>Text a photo:</strong> <a href={sms} style="color:var(--gold);font-weight:600">941-730-8491</a></div>
          <div class="contact-detail"><strong>Email:</strong> <span>projects@gulfwayconstruction.com</span></div>
        </div>
        <form class="contact-form" method="POST" action="https://api.web3forms.com/submit">
          <input type="hidden" name="access_key" value="8e57c099-bf52-4809-b261-521a3afe7b05" />
          <input type="hidden" name="subject" value={`RESIDENTIAL: ${service.name} — ${city.name} | Manatee Concrete`} />
          <input type="hidden" name="redirect" value="https://manateeconcrete.com/thank-you" />
          <input type="hidden" name="project-type" value={`Residential ${service.name}`} />
          <input type="hidden" name="page" value={canonical} />
          <div class="form-row">
            <input type="text" name="first-name" placeholder="First Name" required />
            <input type="text" name="last-name" placeholder="Last Name" required />
          </div>
          <input type="email" name="email" placeholder="Email Address" required />
          <input type="tel" name="phone" placeholder="Phone Number" required />
          <input type="text" name="address" placeholder="Project Address or Neighborhood" />
          <textarea name="message" placeholder={`Tell us about your ${service.name.toLowerCase()} project…`}></textarea>
          <p class="form-consent">Manatee Concrete is a referral service. By submitting, you agree we may share your information with a licensed partner contractor who may call, text or email you about your project.</p>
          <button type="submit">Send Message</button>
        </form>
      </div>
    </div>
  </section>

  <Footer />
  <div class="lp-mbar">
    <a href="tel:9417308491">Call</a>
    <a href={sms}>Text a Photo</a>
    <a href={estimator ? '#driveway-cost' : '#contact'} class="on">{estimator ? 'Price It' : 'Free Estimate'}</a>
  </div>
</Base>

<style>
/* Landing page hero */
.lp-hero {
  position: relative;
  min-height: 60vh;
  display: flex;
  align-items: center;
}
.lp-hero-bg {
  position: absolute; inset: 0;
}
.lp-hero-bg img {
  width: 100%; height: 100%; object-fit: cover;
}
.lp-hero-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(135deg, rgba(26,26,26,.80) 0%, rgba(26,26,26,.55) 100%);
}
.lp-hero-content {
  position: relative;
  z-index: 1;
  color: var(--white);
  padding-top: 120px;
  padding-bottom: 4rem;
}
.lp-hero-content h1 {
  font-family: var(--font-serif);
  font-size: clamp(2rem, 5vw, 3.5rem);
  line-height: 1.15;
  margin: .5rem 0 1rem;
}
.lp-hero-content .hero-eyebrow {
  font-size: .75rem;
  font-weight: 700;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: var(--gold-lt);
}
.lp-hero-content .hero-sub {
  font-size: 1.1rem;
  max-width: 560px;
  margin-bottom: 2rem;
  opacity: .9;
}

/* Intro split */
.lp-intro { padding: 5rem 0; }
.lp-intro-inner {
  display: grid;
  grid-template-columns: 1fr 380px;
  gap: 4rem;
  align-items: start;
}
.lp-intro-text h2 {
  font-family: var(--font-serif);
  font-size: clamp(1.6rem, 3vw, 2.2rem);
  margin: .5rem 0 1.25rem;
}
.lp-lead {
  font-size: 1.1rem;
  color: var(--mid);
  margin-bottom: 1rem;
}
.lp-intro-text p { color: var(--mid); margin-bottom: .9rem; }

.lp-bullets-box {
  background: var(--light);
  border-left: 4px solid var(--gold);
  padding: 2rem;
  border-radius: var(--radius);
  position: sticky;
  top: 130px;
}
.lp-bullets-box h3 {
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: .06em;
  text-transform: uppercase;
  margin-bottom: 1rem;
}
.lp-bullets-box ul {
  list-style: none;
  margin-bottom: 1.5rem;
}
.lp-bullets-box ul li {
  padding: .4rem 0 .4rem 1.4rem;
  position: relative;
  font-size: .95rem;
  color: var(--mid);
  border-bottom: 1px solid rgba(0,0,0,.07);
}
.lp-bullets-box ul li::before {
  content: '✓';
  position: absolute;
  left: 0;
  color: var(--gold);
  font-weight: 700;
}
.lp-cta-box {
  text-align: center;
  padding-top: 1.25rem;
}
.lp-cta-box p { font-size: .85rem; color: var(--mid); margin-bottom: .25rem; }
.lp-cta-box > a:first-of-type {
  display: block;
  font-size: 1.4rem;
  font-weight: 700;
  color: var(--gold);
  margin-bottom: .25rem;
}

/* Why grid */
.lp-why {
  background: var(--dark);
  color: var(--white);
  padding: 5rem 0;
}
.lp-why .section-label { color: var(--gold-lt); }
.lp-why h2 {
  font-family: var(--font-serif);
  font-size: clamp(1.6rem, 3vw, 2.2rem);
  margin: .5rem 0 2.5rem;
}
.lp-why-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 2rem;
}
.lp-why-card { border-top: 2px solid var(--gold); padding-top: 1.25rem; }
.lp-why-card h3 { font-size: 1rem; font-weight: 700; margin-bottom: .6rem; }
.lp-why-card p { font-size: .9rem; color: rgba(255,255,255,.7); line-height: 1.65; }

/* Process bar */
.lp-process { padding: 4rem 0; background: var(--light); }
.lp-process h2 {
  font-family: var(--font-serif);
  font-size: clamp(1.4rem, 2.5vw, 2rem);
  margin: .5rem 0 2.5rem;
}
.lp-process-steps {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
}
.lp-step {
  text-align: center;
  padding: 1.5rem 1rem;
  background: var(--white);
  border-radius: var(--radius);
  border-top: 3px solid var(--gold);
}
.lp-step span {
  display: block;
  font-size: 2rem;
  font-weight: 700;
  color: var(--gold);
  font-family: var(--font-serif);
  margin-bottom: .5rem;
}
.lp-step p { font-size: .85rem; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; }

/* Related services */
.lp-related { padding: 5rem 0; background: var(--light); }
.lp-related h2 {
  font-family: var(--font-serif);
  font-size: clamp(1.4rem, 2.5vw, 2rem);
  margin: .5rem 0 2rem;
}
.lp-related-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 1rem;
}
.lp-related-card {
  background: var(--white);
  border-radius: var(--radius);
  border-left: 3px solid var(--gold);
  padding: 1.1rem 1.25rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-weight: 600;
  font-size: .95rem;
  transition: transform .2s, box-shadow .2s;
}
.lp-related-card:hover { transform: translateX(3px); box-shadow: 0 4px 14px rgba(0,0,0,.08); }
.lp-related-card i { color: var(--gold); font-style: normal; font-size: 1.2rem; }

/* FAQ */
.lp-faq { padding: 5rem 0; }
.lp-faq h2 {
  font-family: var(--font-serif);
  font-size: clamp(1.6rem, 3vw, 2.2rem);
  margin: .5rem 0 2.5rem;
}
.lp-faq-list { max-width: 820px; }
.lp-faq-item {
  border-bottom: 1px solid rgba(0,0,0,.1);
  padding: 1.1rem 0;
}
.lp-faq-item summary {
  font-size: 1.02rem;
  font-weight: 600;
  cursor: pointer;
  list-style: none;
  position: relative;
  padding-right: 2rem;
  color: var(--dark);
}
.lp-faq-item summary::-webkit-details-marker { display: none; }
.lp-faq-item summary::after {
  content: '+';
  position: absolute;
  right: 0;
  top: -2px;
  font-size: 1.5rem;
  font-weight: 400;
  color: var(--gold);
  transition: transform .2s;
}
.lp-faq-item[open] summary::after { content: '\2212'; }
.lp-faq-item p {
  margin-top: .9rem;
  color: var(--mid);
  font-size: .95rem;
  line-height: 1.7;
}


.lp-cost { background: var(--white); border: 1px solid rgba(0,0,0,.08); border-left: 4px solid var(--gold); border-radius: var(--radius); padding: 1.25rem 1.5rem; margin: 1.5rem 0 .5rem; }
.lp-cost h3 { font-size: .8rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--gold); margin-bottom: .4rem; }
.lp-cost p { margin: 0 !important; color: var(--mid); }
.lp-local { padding: 4rem 0; }
.lp-local-inner { max-width: 820px; }
.lp-local h2 { font-family: var(--font-serif); font-size: clamp(1.4rem, 2.5vw, 2rem); margin: .5rem 0 1rem; }
.lp-local p { color: var(--mid); margin-bottom: .9rem; }
.lp-other-cities { margin-top: 2.5rem; }
.lp-other-cities h3 { font-size: .85rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; margin-bottom: 1rem; }

.lp-hero-plain { min-height: 46vh; background: linear-gradient(135deg, var(--dark) 0%, #2b2a26 100%); }
.lp-hero-plain .lp-hero-overlay { display: none; }
.lp-gallery { padding: 4rem 0; background: var(--light); }
.lp-gallery h2 { font-family: var(--font-serif); font-size: clamp(1.4rem, 2.5vw, 2rem); margin: .5rem 0 1.5rem; }
.lp-gallery-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
.lp-gallery-grid figure { margin: 0; }
.lp-gallery-grid img { width: 100%; height: 360px; object-fit: cover; border-radius: var(--radius); display: block; }
.lp-gallery-grid figcaption { font-size: .8rem; color: var(--mid); margin-top: .4rem; }
@media (max-width: 760px) { .lp-gallery-grid { grid-template-columns: 1fr; } .lp-gallery-grid img { height: 300px; } }
.lp-hero-ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; }
.lp-hero-sms { color: var(--white); font-size: .9rem; font-weight: 600; text-decoration: underline; opacity: .9; }
.lp-mbar { display: none; }
@media (max-width: 760px) {
  .lp-mbar { display: grid; grid-template-columns: 1fr 1fr 1fr; position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; background: var(--dark); box-shadow: 0 -4px 16px rgba(0,0,0,.2); padding-bottom: env(safe-area-inset-bottom); }
  .lp-mbar a { color: var(--white); text-align: center; padding: .95rem .25rem; font-size: .78rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; border-right: 1px solid rgba(255,255,255,.12); }
  .lp-mbar a.on { background: var(--gold); border-right: 0; }
  :global(footer) { padding-bottom: 64px; }
}
/* Mobile */
@media (max-width: 860px) {
  .lp-intro-inner { grid-template-columns: 1fr; gap: 2.5rem; }
  .lp-bullets-box { position: static; }
  .lp-process-steps { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 480px) {
  .lp-process-steps { grid-template-columns: 1fr 1fr; }
}
</style>
