---
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}
const {
  title = 'Manatee Concrete | Concrete & Paver Contractors Bradenton FL',
  description = 'Manatee Concrete connects Bradenton, Sarasota, Lakewood Ranch and Manatee County property owners with licensed concrete and paver contractors. Parking lots, driveways, pool decks, pavers and concrete repair. Call 941-730-8491.',
  canonical = 'https://manateeconcrete.com',
} = Astro.props;
// Cloudflare serves pages at /page/ (trailing slash), so canonical URLs must match.
const canonicalUrl = /\/$|\.[a-z0-9]+$/i.test(canonical) ? canonical : canonical + '/';

// Google Analytics 4: paste your Measurement ID (looks like G-XXXXXXXXXX). Empty = no tracking loads.
const GA_ID = '';

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Manatee Concrete",
  "url": "https://manateeconcrete.com",
  "description": "Referral service connecting property owners in Bradenton FL and Manatee & Sarasota County with licensed contractors for parking lots, curb & gutter, sidewalks, concrete repair, residential driveways, stamped concrete, pool decks, pavers and travertine.",
  "telephone": "+19417308491",
  "email": "projects@gulfwayconstruction.com",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Bradenton",
    "addressRegion": "FL",
    "addressCountry": "US"
  },
  "areaServed": [
    { "@type": "City", "name": "Bradenton" },
    { "@type": "City", "name": "Sarasota" },
    { "@type": "City", "name": "Palmetto" },
    { "@type": "City", "name": "Venice" },
    { "@type": "City", "name": "Lakewood Ranch" },
    { "@type": "City", "name": "Parrish" },
    { "@type": "City", "name": "Ellenton" },
    { "@type": "AdministrativeArea", "name": "Manatee County" },
    { "@type": "AdministrativeArea", "name": "Sarasota County" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Concrete & Paver Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Commercial Parking Lots" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Commercial Driveways" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Curb & Gutter" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Sidewalks" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Concrete Repair & Resurfacing" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Residential Driveway Replacement" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Stamped Concrete" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Concrete Pool Decks" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Paver Driveways & Patios" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Travertine Pool Decks" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Paver Repair" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Glass Railings" } }
    ]
  },
  "sameAs": []
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="concrete contractor Bradenton FL, parking lot contractor Manatee County, concrete driveway Sarasota, pavers Bradenton, stamped concrete Sarasota, pool deck Lakewood Ranch" />
    <meta name="robots" content="index, follow" />
    <meta name="geo.region" content="US-FL" />
    <meta name="geo.placename" content="Bradenton, Florida" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://manateeconcrete.com/images/hero.jpg" />
    <meta property="og:site_name" content="Manatee Concrete" />
    <meta property="og:locale" content="en_US" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,700;1,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/global.css" />
    <slot name="head" />
    {GA_ID && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>}
    {GA_ID && <script is:inline define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag('js', new Date());
      window.gtag = gtag;
      gtag('config', GA_ID);
    </script>}
    <script is:inline>
      // track('event_name', {...}) works whether or not GA is set up.
      window.track = function (name, params) { if (window.gtag) window.gtag('event', name, params || {}); };
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href^="tel:"], a[href^="sms:"]');
        if (a) window.track(a.href.indexOf('sms:') === 0 ? 'text_photo_click' : 'phone_click', { page: location.pathname });
      });
      document.addEventListener('submit', function (e) {
        var f = e.target;
        if (!f.matches || !f.matches('form[action*="web3forms"]')) return;
        var pt = f.querySelector('[name="project-type"]');
        window.track('generate_lead', { form: f.classList.contains('dce-form') ? 'driveway_estimator' : 'contact', project_type: pt ? pt.value : '', page: location.pathname });
      });
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
