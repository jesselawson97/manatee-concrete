---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Concrete & Paver Contractors Bradenton FL | Commercial & Residential | Manatee Concrete"
  description="Manatee Concrete connects Bradenton, Sarasota, Lakewood Ranch & Manatee County property owners with licensed concrete and paver contractors. Parking lots, driveways, pool decks, pavers and concrete repair. Call 941-730-8491."
  canonical="https://manateeconcrete.com"
>
  <Nav />

  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg">
      <img src="/images/hero.jpg" alt="Commercial concrete work in Bradenton FL" loading="eager" />
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-content container">
      <p class="hero-eyebrow">Commercial Concrete — Bradenton, FL</p>
      <h1>Built to <em>last.</em><br />Poured with precision.</h1>
      <p class="hero-sub">
        Get matched with licensed local contractors for commercial parking lots and curb &amp; gutter,
        plus residential driveways, pool decks, pavers and travertine. Serving Manatee &amp; Sarasota County.
      </p>
      <a href="#contact" class="btn btn-white">Get a Free Quote</a>
    </div>
  </section>

  <!-- Services -->
  <section class="services-strip" id="services">
    <div class="container">
      <span class="section-label">What We Do</span>
      <h2 class="section-title">Commercial Concrete Services</h2>
      <div class="services-grid">
        <div class="service-card">
          <div class="service-card-img"><img src="/images/service-parking.jpg" alt="Commercial parking lot construction" /></div>
          <div class="service-card-body">
            <h3>Parking Lots</h3>
            <p>New commercial parking lot construction and full-depth replacement. Properly graded, reinforced, and built to handle years of heavy use.</p>
          </div>
        </div>
        <div class="service-card">
          <div class="service-card-img"><img src="/images/service-driveway.jpg" alt="Commercial driveway contractor" /></div>
          <div class="service-card-body">
            <h3>Commercial Driveways</h3>
            <p>Heavy-duty commercial driveways for warehouses, retail centers, and business parks — designed for truck traffic and long-term durability.</p>
          </div>
        </div>
        <div class="service-card">
          <div class="service-card-img"><img src="/images/service-curb.jpg" alt="Curb and gutter installation" /></div>
          <div class="service-card-body">
            <h3>Curb &amp; Gutter</h3>
            <p>Commercial curb and gutter installation and replacement. Proper drainage solutions that protect your property and meet code requirements.</p>
          </div>
        </div>
        <div class="service-card">
          <div class="service-card-img"><img src="/images/service-sidewalk.jpg" alt="Commercial sidewalk construction" /></div>
          <div class="service-card-body">
            <h3>Sidewalks</h3>
            <p>ADA-compliant commercial sidewalks and walkways. New construction and replacement for retail, office, and mixed-use properties.</p>
          </div>
        </div>
        <div class="service-card">
          <div class="service-card-img"><img src="/images/service-repair.jpg" alt="Concrete repair and resurfacing" /></div>
          <div class="service-card-body">
            <h3>Concrete Repair &amp; Resurfacing</h3>
            <p>Crack repair, joint sealing, spall repair, and full resurfacing for aging commercial concrete. Extend the life of your investment.</p>
          </div>
        </div>
      </div>
      <div style="margin-top:3.5rem">
        <span class="section-label">For Homeowners</span>
        <h2 class="section-title">Residential Pavers, Concrete &amp; Stone</h2>
        <div class="services-grid">
          <a class="service-card" href="/paver-driveway-bradenton">
            <div class="service-card-img"><img src="/images/work/paver-driveway-street.jpg" alt="Herringbone paver driveway in Sarasota County" loading="lazy" /></div>
            <div class="service-card-body"><h3>Paver Driveways</h3><p>New paver driveways, or pavers over an existing concrete driveway, for instant curb appeal.</p></div>
          </a>
          <a class="service-card" href="/paver-patio-bradenton">
            <div class="service-card-img"><img src="/images/work/paver-courtyard-patio.jpg" alt="Paver courtyard patio" loading="lazy" /></div>
            <div class="service-card-body"><h3>Patios &amp; Courtyards</h3><p>Paver patios, courtyards and lanai extensions with borders and sealed finishes.</p></div>
          </a>
          <a class="service-card" href="/paver-patio-bradenton">
            <div class="service-card-img"><img src="/images/work/paver-walkway-curved.jpg" alt="Curved paver walkway" loading="lazy" /></div>
            <div class="service-card-body"><h3>Walkways &amp; Entries</h3><p>Paver walkways, front entries and steps that tie the whole property together.</p></div>
          </a>
          <a class="service-card" href="/paver-repair-bradenton">
            <div class="service-card-img"><img src="/images/work/paver-courtyard-steps.jpg" alt="Paver courtyard after releveling and cleaning" loading="lazy" /></div>
            <div class="service-card-body"><h3>Paver Repair &amp; Sealing</h3><p>Releveling sunken pavers, fixing trip hazards, and re-sanding and sealing tired paver areas.</p></div>
          </a>
        </div>
        <a href="/residential" class="btn btn-gold" style="margin-top:2rem">All Residential Services: Concrete, Pool Decks, Travertine &amp; More</a>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="about" id="about">
    <div class="container">
      <div class="about-inner">
        <div class="about-img">
          <img src="/images/about.jpg" alt="Commercial concrete project in Manatee County" />
          <div class="about-img-accent"></div>
        </div>
        <div class="about-text">
          <span class="section-label">About Manatee Concrete</span>
          <h2 class="section-title">How Manatee Concrete Works</h2>
          <p>
            Manatee Concrete is a local referral service. We connect business owners and
            homeowners across Manatee and Sarasota County with licensed, insured contractors for
            parking lots, curb &amp; gutter, concrete repair, driveways, pool decks and pavers.
          </p>
          <p>
            Tell us about your project and we match you with a contractor who does that kind
            of work. The contractor quotes, contracts and performs the job directly with you.
            Our service is free to you; we may receive a referral fee from the contractor.
          </p>
          <br />
          <a href="#contact" class="btn btn-gold">Start Your Project</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Why -->
  <section class="why">
    <div class="container">
      <span class="section-label">Why Manatee Concrete</span>
      <h2 class="section-title" style="color:var(--white)">Concrete Done Right</h2>
      <div class="why-grid">
        <div class="why-card">
          <h3>Commercial &amp; Residential</h3>
          <p>Parking lots and curb &amp; gutter for businesses, and driveways, pool decks and pavers for homeowners.</p>
        </div>
        <div class="why-card">
          <h3>Licensed &amp; Insured</h3>
          <p>We only refer contractors who carry the licenses and insurance their work requires.</p>
        </div>
        <div class="why-card">
          <h3>On Schedule</h3>
          <p>Concrete work delays everything downstream. Our partners set realistic timelines and coordinate with your other trades.</p>
        </div>
        <div class="why-card">
          <h3>Free to You</h3>
          <p>Our matching service costs you nothing, and you're never obligated to hire.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="process" id="process">
    <div class="container">
      <span class="section-label">How It Works</span>
      <h2 class="section-title">Simple. Transparent. Delivered.</h2>
      <div class="process-steps">
        <div class="process-step">
          <div class="step-num">1</div>
          <h3>Tell Us Your Project</h3>
          <p>Call or send the form. We match you with a licensed local contractor, free and with no obligation.</p>
        </div>
        <div class="process-step">
          <div class="step-num">2</div>
          <h3>Detailed Proposal</h3>
          <p>The contractor visits your site and gives you a written, itemized quote.</p>
        </div>
        <div class="process-step">
          <div class="step-num">3</div>
          <h3>Permitting</h3>
          <p>Your contractor pulls the permits and schedules inspections.</p>
        </div>
        <div class="process-step">
          <div class="step-num">4</div>
          <h3>Pour &amp; Finish</h3>
          <p>The contractor's crew builds the project with quality materials.</p>
        </div>
        <div class="process-step">
          <div class="step-num">5</div>
          <h3>Final Walkthrough</h3>
          <p>Walk the finished job with your contractor before final payment.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Areas We Serve -->
  <section class="areas">
    <div class="container">
      <span class="section-label">Areas We Serve</span>
      <h2 class="section-title">Concrete &amp; Pavers Across Manatee &amp; Sarasota County</h2>
      <div class="areas-grid">
        <div class="areas-col">
          <h3>Parking Lots</h3>
          <ul>
            <li><a href="/parking-lot-bradenton">Bradenton</a></li>
            <li><a href="/parking-lot-sarasota">Sarasota</a></li>
            <li><a href="/parking-lot-palmetto">Palmetto</a></li>
            <li><a href="/parking-lot-venice">Venice</a></li>
          </ul>
        </div>
        <div class="areas-col">
          <h3>Driveways</h3>
          <ul>
            <li><a href="/concrete-driveway-bradenton">Bradenton</a></li>
            <li><a href="/concrete-driveway-sarasota">Sarasota</a></li>
            <li><a href="/concrete-driveway-palmetto">Palmetto</a></li>
            <li><a href="/concrete-driveway-venice">Venice</a></li>
          </ul>
        </div>
        <div class="areas-col">
          <h3>Curb &amp; Gutter</h3>
          <ul>
            <li><a href="/curb-gutter-bradenton">Bradenton</a></li>
            <li><a href="/curb-gutter-sarasota">Sarasota</a></li>
            <li><a href="/curb-gutter-palmetto">Palmetto</a></li>
            <li><a href="/curb-gutter-venice">Venice</a></li>
          </ul>
        </div>
        <div class="areas-col">
          <h3>Sidewalks</h3>
          <ul>
            <li><a href="/sidewalk-bradenton">Bradenton</a></li>
            <li><a href="/sidewalk-sarasota">Sarasota</a></li>
            <li><a href="/sidewalk-palmetto">Palmetto</a></li>
            <li><a href="/sidewalk-venice">Venice</a></li>
          </ul>
        </div>
        <div class="areas-col">
          <h3>Concrete Repair</h3>
          <ul>
            <li><a href="/concrete-repair-bradenton">Bradenton</a></li>
            <li><a href="/concrete-repair-sarasota">Sarasota</a></li>
            <li><a href="/concrete-repair-palmetto">Palmetto</a></li>
            <li><a href="/concrete-repair-venice">Venice</a></li>
          </ul>
        </div>
        <div class="areas-col">
          <h3>Residential Driveways</h3>
          <ul>
            <li><a href="/driveway-replacement-bradenton">Bradenton</a></li>
            <li><a href="/driveway-replacement-lakewood-ranch">Lakewood Ranch</a></li>
            <li><a href="/driveway-replacement-sarasota">Sarasota</a></li>
            <li><a href="/driveway-replacement-parrish">Parrish</a></li>
          </ul>
        </div>
        <div class="areas-col">
          <h3>Pavers</h3>
          <ul>
            <li><a href="/paver-driveway-bradenton">Bradenton</a></li>
            <li><a href="/paver-driveway-lakewood-ranch">Lakewood Ranch</a></li>
            <li><a href="/paver-driveway-sarasota">Sarasota</a></li>
            <li><a href="/paver-driveway-parrish">Parrish</a></li>
          </ul>
        </div>
        <div class="areas-col">
          <h3>Pool Decks</h3>
          <ul>
            <li><a href="/concrete-pool-deck-bradenton">Bradenton</a></li>
            <li><a href="/concrete-pool-deck-lakewood-ranch">Lakewood Ranch</a></li>
            <li><a href="/concrete-pool-deck-sarasota">Sarasota</a></li>
            <li><a href="/concrete-pool-deck-parrish">Parrish</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="cta-banner">
    <div class="container">
      <h2>Ready to Get Started?</h2>
      <p>Free on-site estimates for commercial and residential projects throughout Manatee &amp; Sarasota County.</p>
      <a href="#contact" class="btn btn-white">Request a Free Quote</a>
    </div>
  </section>

  <!-- Contact -->
  <section class="contact" id="contact">
    <div class="container">
      <div class="contact-inner">
        <div class="contact-info">
          <span class="section-label">Let's Talk</span>
          <h2>Get a Free Concrete Quote</h2>
          <p>
            Tell us about your project and we'll connect you with a licensed local contractor,
            who will reach out within one business day to schedule a free on-site estimate.
          </p>
          <div class="contact-detail">
            <strong>Phone:</strong> <span>941-730-8491</span>
          </div>
          <div class="contact-detail">
            <strong>Email:</strong> <span>projects@gulfwayconstruction.com</span>
          </div>
          <div class="contact-detail">
            <strong>Service Area:</strong> <span>Manatee &amp; Sarasota County, FL</span>
          </div>
        </div>
        <form class="contact-form" method="POST" action="https://api.web3forms.com/submit">
          <input type="hidden" name="access_key" value="8e57c099-bf52-4809-b261-521a3afe7b05" />
          <input type="hidden" name="subject" value="Concrete Project Inquiry — Manatee Concrete" />
          <input type="hidden" name="redirect" value="https://manateeconcrete.com/thank-you" />
          <div class="form-row">
            <input type="text" name="first-name" placeholder="First Name" required />
            <input type="text" name="last-name" placeholder="Last Name" required />
          </div>
          <input type="email" name="email" placeholder="Email Address" required />
          <input type="tel" name="phone" placeholder="Phone Number" />
          <select name="project-type">
            <option value="" disabled selected>Project Type</option>
            <option>Parking Lot</option>
            <option>Commercial Driveway</option>
            <option>Curb &amp; Gutter</option>
            <option>Sidewalk</option>
            <option>Concrete Repair / Resurfacing</option>
            <option>Residential Driveway</option>
            <option>Stamped Concrete</option>
            <option>Pool Deck</option>
            <option>Pavers / Patio</option>
            <option>Travertine</option>
            <option>Paver Repair / Sealing</option>
            <option>Glass Railings</option>
            <option>Other</option>
          </select>
          <textarea name="message" placeholder="Tell us about your project…"></textarea>
          <p class="form-consent">Manatee Concrete is a referral service. By submitting, you agree we may share your information with a licensed partner contractor who may call, text or email you about your project.</p>
          <button type="submit">Send Message</button>
        </form>
      </div>
    </div>
  </section>

  <Footer />
</Base>
